# Shopify App Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,read_content,write_content,read_themes,write_themes

# Store Configuration
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# Shopify Partner API Token (keep secret!)
SHOPIFY_PARTNER_API_TOKEN=your_partner_api_token_here

# MCP Server Configuration
MCP_SERVER_PORT=3100
MCP_TRANSPORT=stdio

# Database (local dev)
DATABASE_URL="file:./dev.sqlite"

# Turso Database (production - set on Vercel)
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
